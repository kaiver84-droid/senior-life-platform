# 카카오 (없어도 체험 모드로 동작)
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://senior-life-platform.pages.dev/

# Supabase (없으면 메모리/localStorage 폴백)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 배포 도메인
NEXT_PUBLIC_SITE_URL=https://senior-life-platform.pages.dev

# 카카오 애드핏 광고 단위 ID (발급 후 넣으면 퀴즈 결과·오늘의 혜택 하단에 배너가 켜진다)
# 비어 있으면 그 자리에는 아무것도 그리지 않는다. `_UNIT_ID` 이름도 함께 지원한다.
NEXT_PUBLIC_ADFIT_QUIZ_UNIT=
NEXT_PUBLIC_ADFIT_WELFARE_UNIT=

# 개인정보처리방침 ‘문의’에 표시할 운영자 연락처(이메일·안내 링크). 비우면 그 줄을 그리지 않는다.
NEXT_PUBLIC_OPERATOR_CONTACT=
